# --- Enable Banking application credentials ---
# Your registered application ID (shown in the Enable Banking control panel).
EB_APP_ID=cfcd440b-3143-40eb-945f-81c9b567f420

# Absolute path to the private key .pem you downloaded at registration.
# Keep this file OUTSIDE the repo. Example:
EB_PRIVATE_KEY_PATH=/Users/you/enable-banking/cfcd440b-3143-40eb-945f-81c9b567f420.pem

# Enable Banking API base URL (leave as-is).
EB_BASE_URL=https://api.enablebanking.com

# The redirect URL registered with Enable Banking that the bank sends the user
# back to. For local dev this is your https tunnel callback, e.g.
# https://your-subdomain.trycloudflare.com/callback
# (Must EXACTLY match one of the redirect URLs registered on the app.)
EB_REDIRECT_URL=https://localhost:8000/callback

# Country for the bank list (ISO 3166-1 alpha-2). GB = United Kingdom.
EB_COUNTRY=GB

# --- Server ---
PORT=8000

# --- Database (SQLite for dev) ---
# Path is relative to the prisma/ schema directory, so this lands at
# server/prisma/dev.db (git-ignored).
DATABASE_URL="file:./dev.db"
